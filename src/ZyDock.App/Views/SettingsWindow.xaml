<Window x:Class="ZyDock.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ZyDock 设置"
        Width="800"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}"
        TextOptions.TextFormattingMode="Ideal">

    <Border CornerRadius="18"
            Background="{StaticResource WindowGlassBrush}"
            BorderBrush="#2AFFFFFF"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderBar"
                    Grid.Row="0"
                    Background="Transparent"
                    Padding="24,18,16,12"
                    MouseLeftButtonDown="OnHeaderDrag">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <TextBlock Text="ZyDock" Style="{StaticResource TitleText}" />
                        <TextBlock Text="透明悬浮 Dock 栏设置"
                                   Style="{StaticResource HintText}"
                                   Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button x:Name="MinimizeButton"
                                Style="{StaticResource WindowButton}"
                                Click="OnMinimizeClick"
                                ToolTip="最小化">
                            <TextBlock Text="-" FontSize="13" />
                        </Button>
                        <Button x:Name="CloseButton"
                                Style="{StaticResource CloseWindowButton}"
                                Click="OnCloseClick"
                                Margin="4,0,0,0"
                                ToolTip="隐藏到托盘">
                            <TextBlock Text="X" FontSize="12" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          x:Name="BodyScroll"
                          Style="{StaticResource SlimScrollViewer}"
                          VerticalScrollBarVisibility="Auto"
                          Padding="0,0,10,0"
                          Margin="24,0,14,20">
                <StackPanel x:Name="BodyPanel">

                    <TextBlock Text="外观" Style="{StaticResource SectionText}" />
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="图标大小" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="磁吸放大后依然清晰，建议 50 - 60" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Slider x:Name="IconSizeSlider" Style="{StaticResource FineSlider}" Width="190"
                                            Minimum="32" Maximum="80" IsSnapToTickEnabled="True" TickFrequency="1" />
                                    <TextBlock x:Name="IconSizeValue" Style="{StaticResource ValueText}" Margin="12,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#14FFFFFF" Margin="0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="图标间距" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="图标之间的呼吸空间" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Slider x:Name="SpacingSlider" Style="{StaticResource FineSlider}" Width="190"
                                            Minimum="2" Maximum="24" IsSnapToTickEnabled="True" TickFrequency="1" />
                                    <TextBlock x:Name="SpacingValue" Style="{StaticResource ValueText}" Margin="12,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#14FFFFFF" Margin="0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="内边距（左右）" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="胶囊左右两侧到第一个/最后一个图标的留白" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Slider x:Name="PaddingXSlider" Style="{StaticResource FineSlider}" Width="190"
                                            Minimum="0" Maximum="80" IsSnapToTickEnabled="True" TickFrequency="1" />
                                    <TextBlock x:Name="PaddingXValue" Style="{StaticResource ValueText}" Margin="12,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#14FFFFFF" Margin="0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="内边距（上下）" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="图标上下与胶囊边缘的留白" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Slider x:Name="PaddingYSlider" Style="{StaticResource FineSlider}" Width="190"
                                            Minimum="0" Maximum="60" IsSnapToTickEnabled="True" TickFrequency="1" />
                                    <TextBlock x:Name="PaddingYValue" Style="{StaticResource ValueText}" Margin="12,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#14FFFFFF" Margin="0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="背景透明度" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="越低越接近全透明，建议 20% – 35%" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Slider x:Name="OpacitySlider" Style="{StaticResource FineSlider}" Width="190"
                                            Minimum="0.05" Maximum="0.92" />
                                    <TextBlock x:Name="OpacityValue" Style="{StaticResource ValueText}" Margin="12,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#14FFFFFF" Margin="0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="玻璃高光" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="顶部高光 / 内侧倒角 / 底部反光，关掉后是纯透明面板" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="GlassToggle" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}" />
                            </Grid>

                            <Border Height="1" Background="#14FFFFFF" Margin="0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="边缘反光" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="胶囊顶边那道细高光的强度，0 = 完全不显示" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Slider x:Name="SpecularSlider" Style="{StaticResource FineSlider}" Width="190"
                                            Minimum="0" Maximum="1" />
                                    <TextBlock x:Name="SpecularValue" Style="{StaticResource ValueText}" Margin="12,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#14FFFFFF" Margin="0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="底部阴影" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="胶囊下方的柔和投影，关掉后 Dock 完全平贴桌面" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="ShadowToggle" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}" />
                            </Grid>

                            <Border Height="1" Background="#14FFFFFF" Margin="0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="图标拖影" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="图标下方显示一层很淡的倒影（类似 macOS 的反光）" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="ReflectionToggle" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}" />
                            </Grid>

                            <Border Height="1" Background="#14FFFFFF" Margin="0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="拖影大小" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="图标下方倒影的高度，0 = 不显示" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Slider x:Name="ReflectionSizeSlider" Style="{StaticResource FineSlider}" Width="190"
                                            Minimum="0" Maximum="1.6" />
                                    <TextBlock x:Name="ReflectionSizeValue" Style="{StaticResource ValueText}" Margin="12,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#14FFFFFF" Margin="0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="玻璃颜色" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="白底上偏黑就换成浅色；深色 = 烟熏玻璃，浅色 = 清透玻璃" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="TintClear" Tag="__clear__" Width="22" Height="22" Margin="0,0,6,0"
                                            Padding="0" BorderThickness="1" BorderBrush="#40FFFFFF" Background="Transparent"
                                            Style="{StaticResource TintSwatchButton}" ToolTip="清底（不要底色，直接透出背景）" Click="OnTintSwatchClick">
                                        <TextBlock Text="∅" FontSize="12" Foreground="#C8FFFFFF" />
                                    </Button>
                                    <Button x:Name="TintDark" Tag="#0B0E13" Width="22" Height="22" Margin="0,0,6,0"
                                            Padding="0" BorderThickness="1" BorderBrush="#40FFFFFF" Background="#0B0E13"
                                            Style="{StaticResource TintSwatchButton}" ToolTip="石墨黑（默认）" Click="OnTintSwatchClick" />
                                    <Button x:Name="TintGray" Tag="#2F353D" Width="22" Height="22" Margin="0,0,6,0"
                                            Padding="0" BorderThickness="1" BorderBrush="#40FFFFFF" Background="#2F353D"
                                            Style="{StaticResource TintSwatchButton}" ToolTip="深空灰" Click="OnTintSwatchClick" />
                                    <Button x:Name="TintSilver" Tag="#C8D2DC" Width="22" Height="22" Margin="0,0,6,0"
                                            Padding="0" BorderThickness="1" BorderBrush="#40FFFFFF" Background="#C8D2DC"
                                            Style="{StaticResource TintSwatchButton}" ToolTip="冷银（白底推荐）" Click="OnTintSwatchClick" />
                                    <Button x:Name="TintWhite" Tag="#FFFFFF" Width="22" Height="22" Margin="0,0,6,0"
                                            Padding="0" BorderThickness="1" BorderBrush="#40FFFFFF" Background="#FFFFFF"
                                            Style="{StaticResource TintSwatchButton}" ToolTip="纯白" Click="OnTintSwatchClick" />
                                    <Button x:Name="TintBlue" Tag="#7FA8FF" Width="22" Height="22" Margin="0,0,6,0"
                                            Padding="0" BorderThickness="1" BorderBrush="#40FFFFFF" Background="#7FA8FF"
                                            Style="{StaticResource TintSwatchButton}" ToolTip="冰蓝" Click="OnTintSwatchClick" />
                                    <Button x:Name="TintViolet" Tag="#B49BFF" Width="22" Height="22" Margin="0,0,10,0"
                                            Padding="0" BorderThickness="1" BorderBrush="#40FFFFFF" Background="#B49BFF"
                                            Style="{StaticResource TintSwatchButton}" ToolTip="淡紫" Click="OnTintSwatchClick" />
                                    <TextBox x:Name="TintHexBox" Width="92" Height="26" VerticalContentAlignment="Center"
                                             Style="{StaticResource HexTextBox}" ToolTip="自定义颜色：#RRGGBB，回车生效" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0"
                                       Text="底板为「清玻璃」：不模糊、不取壁纸、不做颗粒噪点，只是近乎透明的一层薄雾 + 发丝描边 + 柔和投影，Dock 后面是什么就直接透出什么。" />                            <Border Height="1" Background="#14FFFFFF" Margin="0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="边框粗细" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="0 = 完全无边框；建议 0.5 – 1.5" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Slider x:Name="BorderSlider" Style="{StaticResource FineSlider}" Width="190"
                                            Minimum="0" Maximum="3" IsSnapToTickEnabled="True" TickFrequency="0.5" />
                                    <TextBlock x:Name="BorderValue" Style="{StaticResource ValueText}" Margin="12,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#14FFFFFF" Margin="0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="鼠标放大" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="光标靠近时图标平滑放大" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="MagnifyToggle" Grid.Column="1"
                                              Style="{StaticResource ToggleSwitch}" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="放大倍数" Style="{StaticResource LabelText}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Slider x:Name="MagnifySlider" Style="{StaticResource FineSlider}" Width="190"
                                            Minimum="1.1" Maximum="1.9" />
                                    <TextBlock x:Name="MagnifyValue" Style="{StaticResource ValueText}" Margin="12,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#14FFFFFF" Margin="0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="名称提示" Style="{StaticResource LabelText}" />
                                <ToggleButton x:Name="LabelsToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="运行状态指示点" Style="{StaticResource LabelText}" />
                                <ToggleButton x:Name="IndicatorToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="行为" Style="{StaticResource SectionText}" />
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="自动隐藏" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="鼠标离开后滑出屏幕，移到底部边缘唤回" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="AutoHideToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" />
                            </Grid>

                            <Border Height="1" Background="#14FFFFFF" Margin="0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="最大化/全屏时自动隐藏" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="前台窗口最大化或全屏时 Dock 完全隐藏（任何软件都算），还原窗口后自动恢复" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="FullscreenToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" />
                            </Grid>

                            <Border Height="1" Background="#14FFFFFF" Margin="0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="隐藏 Windows 任务栏" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="通过系统 AppBar 接口把任务栏设为自动隐藏，退出时自动恢复" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="HideTaskbarToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" />
                            </Grid>

                            <Border Height="1" Background="#14FFFFFF" Margin="0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="开机启动" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="登录后自动运行（仅写入当前用户启动项）" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <ToggleButton x:Name="AutoStartToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" />
                            </Grid>

                            <Border Height="1" Background="#14FFFFFF" Margin="0,12" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="距屏幕底边" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="Dock 与屏幕（或任务栏）底部的距离" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Slider x:Name="EdgeOffsetSlider" Style="{StaticResource FineSlider}" Width="190"
                                            Minimum="0" Maximum="64" IsSnapToTickEnabled="True" TickFrequency="1" />
                                    <TextBlock x:Name="EdgeOffsetValue" Style="{StaticResource ValueText}" Margin="12,0,0,0" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#14FFFFFF" Margin="0,12" />

                            <StackPanel>
                                <TextBlock Text="显示屏幕" Style="{StaticResource LabelText}" />
                                <TextBlock Text="多显示器时 Dock 只出现在选定的屏幕上" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                <WrapPanel x:Name="ScreenPanel" Orientation="Horizontal" Margin="0,10,0,0" />
                            </StackPanel>

                            <TextBlock x:Name="PositionHint"
                                       Style="{StaticResource HintText}"
                                       Margin="0,12,0,0"
                                       Text="当前版本 Dock 固定贴底边显示（顶部 / 侧边布局未实现）。" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Dock 图标" Style="{StaticResource SectionText}" />
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="图标列表" Style="{StaticResource LabelText}" />
                                    <TextBlock Text="可添加应用或文件夹，调整顺序，或移除" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="AddFileButton" Content="添加应用..." Style="{StaticResource SoftButton}"
                                            Padding="12,6" Margin="0,0,8,0" Click="OnAddFileClick" />
                                    <Button x:Name="AddFolderButton" Content="添加文件夹..." Style="{StaticResource SoftButton}"
                                            Padding="12,6" Click="OnAddFolderClick" />
                                </StackPanel>
                            </Grid>

                            <StackPanel x:Name="IconListPanel" Margin="0,14,0,0" />

                            <TextBlock x:Name="IconEmptyHint"
                                       Text="Dock 中还没有图标，点击「添加应用...」开始。"
                                       Style="{StaticResource HintText}"
                                       Margin="0,10,0,0"
                                       Visibility="Collapsed" />

                            <Border Height="1" Background="#14FFFFFF" Margin="0,14" />

                            <StackPanel Orientation="Horizontal">
                                <Button Content="恢复默认图标" Style="{StaticResource GhostButton}" Click="OnResetIconsClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="关于" Style="{StaticResource SectionText}" />
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="VersionText" Style="{StaticResource LabelText}" Text="ZyDock" />
                                    <TextBlock x:Name="ConfigPathText" Style="{StaticResource HintText}" Margin="0,4,0,0" />
                                    <TextBlock x:Name="LogPathText" Style="{StaticResource HintText}" Margin="0,2,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button Content="打开配置目录" Style="{StaticResource SoftButton}" Padding="12,6"
                                            Margin="0,0,8,0" Click="OnOpenConfigClick" />
                                    <Button Content="恢复默认设置" Style="{StaticResource DangerButton}" Padding="12,6"
                                            Click="OnRestoreDefaultsClick" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="#14FFFFFF" Margin="0,14" />

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ExitButton" Content="退出 ZyDock" Style="{StaticResource SoftButton}"
                                        Padding="14,7" Click="OnExitClick" />
                                <Button Content="关闭窗口（保留后台运行）" Style="{StaticResource GhostButton}"
                                        Margin="10,0,0,0" Click="OnCloseClick" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
