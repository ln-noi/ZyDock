<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    This solution has zero NuGet dependencies by design, so restore never needs the
    internet. The local source exists only for the runtime packs used by the
    self-contained publish (see docs/BUILD.md).
  -->
  <packageSources>
    <clear />
    <add key="local" value=".tools\nuget-local" />
  </packageSources>
  <config>
    <add key="globalPackagesFolder" value=".tools\nuget" />
  </config>
</configuration>
